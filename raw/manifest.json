{
  "short_name": "crawler-tool",
  "name": "crawl resource",
  "icons": {
    "16": "./16x16.png",
    "32": "./32x32.png",
    "80": "./80x80.png",
    "120": "./120x120.png"
  },
  "permissions": [
    "activeTab",
    "tabs",
    "cookies",
    "storage",
    "scripting",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "socket.io.min.js",
        "./content-script.js"
      ],
      "css": [
        "./main.css"
      ],
      "run_at": "document_end"
    }
  ],
  "manifest_version": 3,
  "version": "0.2.0"
}